<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Export CSV and PDF</title>
</head>
<body>
<h1>Users List</h1>
<table border="1">
<thead>
<tr>
<th>ID</th>
<th>Name</th>
<th>Email</th>
</tr>
</thead>
<tbody>
<% users.forEach(function(user) { %>
<tr>
<td><%= user.id %></td>
<td><%= user.name %></td>

<td><%= user.email %></td>
</tr>
<% }); %>
</tbody>
</table>

<h2>Download</h2>
<a href="/download/csv">Download CSV</a><br>
<a href="/download/pdf">Download PDF</a>
</body>
</html>